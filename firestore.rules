rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 랭킹: 문서 ID = 익명 로그인 uid. 누구나 읽고, 자기 문서만 쓸 수 있으며 기록은 줄어드는 방향으로만 바뀐다.
    match /scores/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && valid();
      allow update: if isOwner(uid) && valid()
        && request.resource.data.total <= resource.data.total;
      allow delete: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function valid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'total', 'at'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.total is number && d.total >= 20 && d.total < 3600
        && d.at == request.time;
    }
  }
}
